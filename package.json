{
  "name": "tom-and-jerry-chase-wiki",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.18.0",
  "description": "专为《猫和老鼠手游》玩家打造的数据查询网站",
  "homepage": "https://www.tjwiki.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/asHOH/Tom-and-jerry-chase-wiki.git"
  },
  "bugs": {
    "url": "https://github.com/asHOH/Tom-and-jerry-chase-wiki/issues"
  },
  "funding": {
    "type": "patreon",
    "url": "https://patreon.com/asHOH"
  },
  "author": "asHOH",
  "license": "(CC-BY-4.0 AND GPL-3.0-or-later)",
  "keywords": [
    "tom-and-jerry",
    "mobile-game",
    "wiki",
    "nextjs",
    "react"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/run-build-with-game-data.mjs build:output",
    "build:debug": "node scripts/run-build-with-game-data.mjs build:output:debug",
    "build:output": "npm run validate:actor-profiles && node scripts/generate-doc-pages.mjs && next build && serwist build serwist.config.mjs && node scripts/run-image-optimization.cjs",
    "build:output:debug": "npm run validate:actor-profiles && node scripts/generate-doc-pages.mjs && next build --debug && serwist build serwist.config.mjs && node scripts/run-image-optimization.cjs",
    "generate:changelogs": "node scripts/generate-changelogs.mjs",
    "generate:database-types": "node scripts/generate-database-types.mjs",
    "generate:map-tiles": "node scripts/generate-map-tiles.mjs",
    "report:character-relations": "node scripts/report-character-relations.mjs",
    "set-runtime:edge": "node scripts/set-api-runtime.mjs edge",
    "set-runtime:node": "node scripts/set-api-runtime.mjs nodejs",
    "build:skip-images": "node scripts/run-build-with-game-data.mjs build:output:skip-images",
    "build:output:skip-images": "npm run validate:actor-profiles && node scripts/generate-doc-pages.mjs && next build && serwist build serwist.config.mjs",
    "normalize:actor-profiles": "jiti scripts/normalize-actor-profiles.ts",
    "validate:actor-profiles": "jiti scripts/validate-actor-profiles.ts",
    "start": "next start",
    "lint": "oxlint",
    "lint:fast": "oxlint",
    "lint:deps": "knip --dependencies --reporter compact",
    "lint:fix": "oxlint --fix",
    "lint:staged": "oxlint --fix --max-warnings=0",
    "check:database-types": "node scripts/generate-database-types.mjs --check",
    "prettier:check": "prettier --check . --cache",
    "prettier:fix": "prettier --write . --cache",
    "prettier:staged": "prettier --write --ignore-unknown --cache",
    "format": "npm run prettier:fix && npm run lint:fix",
    "type-check": "tsc --noEmit",
    "type-check:watch": "tsc --noEmit --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --watchAll=false --maxWorkers=50%",
    "test:changed": "jest --onlyChanged --passWithNoTests",
    "clean": "rimraf .next out coverage",
    "analyze": "cross-env ANALYZE=true npm run build",
    "audit:game-data-actions": "node scripts/audit-game-data-actions.mjs",
    "inspect:game-data-actions": "node scripts/inspect-game-data-actions.mjs",
    "verify:game-data-actions": "node scripts/verify-game-data-actions.mjs",
    "verify:game-data-compaction": "node scripts/verify-game-data-compaction.mjs",
    "report:admin-game-data-action-timings": "node scripts/ops/summarize-admin-game-data-action-timings.mjs",
    "audit": "npm audit --audit-level=moderate",
    "outdated": "npm outdated",
    "size": "size-limit",
    "update-readme": "node scripts/update-readme-acknowledgments.mjs",
    "cleanup-temp": "rimraf scripts/temp",
    "pre-push:force-fast": ".husky/pre-push-fast",
    "pre-push:force-full": "cross-env FORCE_FULL_PREPUSH=true .husky/pre-push",
    "prepare": "husky"
  },
  "engines": {
    "node": "^22.9.0 || ^24.0.0 || ^26.0.0",
    "npm": ">=11.12.1 <12"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^22.9.0 || ^24.0.0 || ^26.0.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": ">=11.12.1 <12",
      "onFail": "error"
    }
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.71",
    "@ai-sdk/react": "^3.0.207",
    "@formatjs/intl-segmenter": "^12.2.13",
    "@hcaptcha/react-hcaptcha": "^2.0.2",
    "@marsidev/react-turnstile": "^1.5.4",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/env": "^16.3.1",
    "@next/mdx": "^16.3.1",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@serwist/next": "^9.5.12",
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "^2.111.0",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tanstack/react-virtual": "^3.14.9",
    "@tiptap/core": "3.29.2",
    "@tiptap/extension-image": "3.29.2",
    "@tiptap/extension-link": "3.29.2",
    "@tiptap/extension-table": "3.29.2",
    "@tiptap/extension-table-cell": "3.29.2",
    "@tiptap/extension-table-header": "3.29.2",
    "@tiptap/extension-table-row": "3.29.2",
    "@tiptap/pm": "3.29.2",
    "@tiptap/react": "3.29.2",
    "@tiptap/starter-kit": "3.29.2",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.1",
    "@vercel/analytics": "^1.6.1",
    "@vercel/speed-insights": "^1.3.1",
    "ai": "^6.0.193",
    "clsx": "^2.1.1",
    "core-js": "^3.49.0",
    "date-fns": "^4.4.0",
    "diff": "^9.0.0",
    "esbuild-wasm": "^0.28.1",
    "html-react-parser": "^6.1.5",
    "json5": "^2.2.3",
    "leaflet": "^1.9.4",
    "lodash-es": "^4.18.1",
    "motion": "^12.43.0",
    "next": "^16.3.1",
    "next-themes": "^0.4.6",
    "nextjs-toploader": "^3.9.17",
    "pinyin-pro": "^3.28.2",
    "proxy-compare": "^3.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-leaflet": "^5.0.0",
    "react-plock": "^3.6.1",
    "remark-gfm": "^4.0.1",
    "sanitize-html": "^2.17.6",
    "serwist": "^9.5.3",
    "sharp": "^0.35.3",
    "sonner": "^2.0.7",
    "swr": "^2.4.2",
    "tailwind-merge": "^3.6.0",
    "usehooks-ts": "^3.1.1",
    "valtio": "^2.3.2",
    "vm2": "^3.11.5",
    "web-streams-polyfill": "^3.3.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@next/bundle-analyzer": "^16.3.1",
    "@serwist/cli": "^9.5.12",
    "@size-limit/file": "^12.1.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "@types/leaflet": "^1.9.21",
    "@types/lodash-es": "^4.17.12",
    "@types/mdx": "^2.0.14",
    "@types/node": "^22.20.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/sanitize-html": "^2.16.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "cross-env": "^10.1.0",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.4",
    "eslint-plugin-jest-dom": "^5.5.0",
    "eslint-plugin-testing-library": "^7.16.2",
    "eslint-plugin-unused-imports": "^4.4.1",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "jiti": "^2.7.0",
    "knip": "^6.31.0",
    "lint-staged": "^16.4.0",
    "lodash": "^4.18.1",
    "oxlint": "^1.76.0",
    "postcss": "^8.5.15",
    "postcss-preset-env": "^11.3.2",
    "prettier": "^3.9.1",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "rimraf": "^6.1.3",
    "schema-dts": "^2.0.0",
    "server-only": "^0.0.1",
    "size-limit": "^12.1.0",
    "supabase": "2.111.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "trim-newlines": "^3.0.1",
    "js-yaml": "^4.1.1",
    "postcss": "^8.5.15"
  },
  "size-limit": [
    {
      "path": ".next/static/chunks/main-*.js",
      "limit": "60 KB",
      "gzip": true
    },
    {
      "path": ".next/static/chunks/framework-*.js",
      "limit": "80 KB",
      "gzip": true
    },
    {
      "path": ".next/static/chunks/[0-9]*-*.js",
      "limit": "260 KB",
      "gzip": true
    }
  ],
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx,mjs,cjs}": [
      "oxlint --deny-warnings",
      "prettier --write --ignore-unknown --cache"
    ],
    "**/*.{json,css,md,mdx,html,yml,yaml}": "prettier --write --ignore-unknown --cache"
  },
  "allowScripts": {
    "core-js@3.49.0": false,
    "esbuild@0.28.1": true,
    "unrs-resolver@1.11.1": true,
    "sharp@0.35.3": true
  }
}
