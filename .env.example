# Copy this file to .env.local (for development) or .env.production
# (the Linux deployment script), then replace only the values for features you enable.

# Core feature defaults
# Feedback email and articles are disabled by default so a basic deployment needs no
# Resend or Supabase credentials. Set a flag to 0 only after configuring that service.
NEXT_PUBLIC_DISABLE_FEEDBACK_EMAIL=1
NEXT_PUBLIC_DISABLE_ARTICLES=1

# Feedback Collection Configuration

# Email Service (Resend)
RESEND_API_KEY=your_resend_api_key_here
FEEDBACK_EMAIL=your-email@example.com
RESEND_FROM_EMAIL=feedback@email.tjwiki.com
# Optional; falls back to the Supabase server secret when omitted
NOTIFICATION_UNSUBSCRIBE_SECRET=replace_with_at_least_32_random_characters

# Analytics (set to 1 to force-enable, 0 to disable)
# NEXT_PUBLIC_ENABLE_VERCEL_ANALYTICS=0

# Supabase Configuration
# Required only when NEXT_PUBLIC_DISABLE_ARTICLES=0. URL and publishable key are enough
# for read-only articles. Use your own Supabase project values, or contact the site
# maintainer if you have permission to use the maintained production project.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here
# Server-side secret for privileged/authenticated features. Never expose it to clients.
SUPABASE_SECRET_KEY=your_supabase_secret_key_here
NEXT_PUBLIC_SUPABASE_AUTH_USER_EMAIL_DOMAIN=email.tjwiki.com

# Disable Wikitext Editor (uncomment to disable)
# NEXT_PUBLIC_DISABLE_WIKITEXT_EDITOR=1

# Captcha (optional; leave all three unset to disable)
# Provider can be "hcaptcha" or "turnstile". The site and secret keys must belong to it.
# NEXT_PUBLIC_CAPTCHA_PROVIDER=turnstile
# NEXT_PUBLIC_CAPTCHA_SITE_KEY=your_turnstile_site_key_here
# CAPTCHA_SECRET_KEY=your_turnstile_secret_key_here

# Chat Service (AI)
NEXT_PUBLIC_AI_CHAT_MODEL=gpt-5.6-luna
OPENAI_API_KEY=your_openai_api_key_here
# Optional: Custom base URL for OpenAI-compatible providers
# OPENAI_BASE_URL=https://api.openai.com/v1

# Image
# NEXT_PUBLIC_DISABLE_IMAGE_OPTIMIZATION=1

# Rate Limit (optional; @upstash/redis + @upstash/ratelimit)
# Leave both unset to skip API rate limiting.
# UPSTASH_REDIS_REST_URL=https://example.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token_here

# SEO Configuration
NEXT_PUBLIC_SITE_URL=https://www.tjwiki.com

# Optional ICP filing footer; set this to the exact issued filing number to display it.
# NEXT_PUBLIC_ICP_RECORD_NUMBER=your_issued_icp_record_number_here

# Optional immutable deployment/build identifier. When omitted, the build generates one UUID.
# DEPLOY_BUILD_ID=your-provider-deployment-id

# Optional commit identifier used by /api/version. Prefer COMMIT_SHA; the deployment
# script and supported hosting providers may inject one of the provider-specific aliases.
# COMMIT_SHA=your-git-commit-sha
# DEPLOY_COMMIT_SHA=your-git-commit-sha

# Optional deployment environment label: development, preview, or production.
# When omitted, the application falls back to provider metadata and NODE_ENV.
# DEPLOYMENT_ENVIRONMENT=production

# Internal build-wrapper variable. Do not set this in a deployed runtime environment.
# GAME_DATA_BUILD_ARTIFACT_PATH=/absolute/path/to/attempt-specific-artifact.json

# EchoFlow API Configuration
# Set a secret key to enable the EchoFlow API
# If not set, the API will return 503 Service Disabled
FLOWKEY=your-flow-secret-key-here
