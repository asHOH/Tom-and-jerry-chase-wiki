# Feedback Collection Configuration

# Email Service (Resend)
NEXT_PUBLIC_DISABLE_FEEDBACK_EMAIL=1
RESEND_API_KEY=your_resend_api_key_here
FEEDBACK_EMAIL=your-email@example.com
RESEND_FROM_EMAIL=feedback@email.tjwiki.com
# Optional; falls back to the Supabase server secret when omitted
NOTIFICATION_UNSUBSCRIBE_SECRET=replace_with_at_least_32_random_characters

# Analytics (set to 1 to force-enable, 0 to disable)
# NEXT_PUBLIC_ENABLE_VERCEL_ANALYTICS=0

# Disable Articles Feature (uncomment to disable)
# NEXT_PUBLIC_DISABLE_ARTICLES=1

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://gehfogfxgbkwwwcamogj.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_BwWh5cToo8Na8OWQezM4gw_YTMWolas
SUPABASE_SECRET_KEY=your_supabase_secret_key_here
NEXT_PUBLIC_SUPABASE_AUTH_USER_EMAIL_DOMAIN=email.tjwiki.com

# Disable Wikitext Editor (uncomment to disable)
# NEXT_PUBLIC_DISABLE_WIKITEXT_EDITOR=1

# Enable Captcha for Pages ("hcaptcha" or "turnstile") (comment to disable)
NEXT_PUBLIC_CAPTCHA_PROVIDER=turnstile
NEXT_PUBLIC_CAPTCHA_SITE_KEY=your_turnstile_site_key_here
CAPTCHA_SECRET_KEY=your_turnstile_secret_key_here

# Chat Service (AI)
NEXT_PUBLIC_AI_CHAT_MODEL=gpt-5.4
OPENAI_API_KEY=your_openai_api_key_here
# Optional: Custom base URL for OpenAI-compatible providers
# OPENAI_BASE_URL=https://api.openai.com/v1

# Image
# NEXT_PUBLIC_DISABLE_IMAGE_OPTIMIZATION=1

# Rate Limit
UPSTASH_REDIS_REST_URL=https://example.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token_here

# SEO Configuration
NEXT_PUBLIC_SITE_URL=https://tjwiki.com

# Optional ICP filing footer; set this to the exact issued filing number to display it.
# NEXT_PUBLIC_ICP_RECORD_NUMBER=your_issued_icp_record_number_here

# Optional immutable deployment/build identifier. When omitted, the build generates one UUID.
# DEPLOY_BUILD_ID=your-provider-deployment-id

# EchoFlow API Configuration
# Set a secret key to enable the EchoFlow API
# If not set, the API will return 503 Service Disabled
FLOWKEY=your-flow-secret-key-here
